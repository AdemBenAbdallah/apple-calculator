{
	"name": "apple-calculator",
	"version": "1.0.0",
	"description": "Apple-style calculator built with HTML, CSS, and JavaScript",
	"main": "src/calculator.js",
	"scripts": {
		"test": "playwright test",
		"test:e2e": "playwright test",
		"typecheck": "tsc --noEmit --allowJs",
		"lint": "echo 'No linting configured'",
		"start": "npx serve .",
		"dev": "npx serve . -l 3000",
		"build": "tsc",
		"build:js": "tsc src/main.ts --outDir src --module commonjs --target ES2020",
		"watch": "tsc --watch"
	},
	"devDependencies": {
		"@playwright/test": "^1.57.0",
		"@types/jest": "^29.5.0",
		"@types/node": "^20.0.0",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^30.2.0",
		"serve": "^14.2.0",
		"ts-jest": "^29.1.0",
		"ts-node": "^10.9.0",
		"typescript": "^5.3.0"
	},
	"keywords": [
		"calculator",
		"apple",
		"html",
		"css",
		"javascript",
		"typescript"
	],
	"author": "",
	"license": "ISC"
}
